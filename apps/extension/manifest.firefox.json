{
  "manifest_version": 3,
  "name": "Rangrez \u2014 try it on yourself",
  "version": "0.1.0",
  "description": "Finds the clothes on a shop page, works out what the piece is, and hangs it on your own avatar without leaving the tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rangrez@rangrez.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Rangrez",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.google.com/*",
        "*://*.gmail.com/*",
        "*://mail.google.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*",
        "*://*.whatsapp.com/*",
        "*://*.notion.so/*",
        "*://*.figma.com/*",
        "*://*.github.com/*",
        "*://*.slack.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": [
        "src/lib/api-global.js",
        "src/lib/taxonomy.js",
        "src/lib/sites.js",
        "src/content/detect.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/lib/api-global.js",
        "src/pair.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*.woff2",
        "assets/icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
